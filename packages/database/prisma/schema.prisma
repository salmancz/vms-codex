generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum RecordStatus { ACTIVE INACTIVE SUSPENDED ARCHIVED }
enum VisitStatus { SCHEDULED INVITED PENDING_APPROVAL APPROVED REJECTED ARRIVED CHECKED_IN CHECKED_OUT CANCELLED EXPIRED NO_SHOW }
enum ApprovalStatus { NOT_REQUIRED PENDING APPROVED REJECTED }
enum GateType { MAIN VISITOR EMPLOYEE SERVICE OTHER }
enum NotificationChannel { EMAIL SMS WHATSAPP PUSH }

model Organization { id String @id @default(cuid()) name String slug String @unique logoUrl String? email String? phone String? timezone String @default("Asia/Kolkata") country String @default("IN") currency String @default("INR") primaryColor String @default("#2563eb") status RecordStatus @default(ACTIVE) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt locations Location[] departments Department[] employees Employee[] users User[] visitors Visitor[] visits Visit[] visitorTypes VisitorType[] auditLogs AuditLog[] communicationUsage CommunicationUsage[] retentionDays Int @default(365) }
model Location { id String @id @default(cuid()) organizationId String organization Organization @relation(fields:[organizationId], references:[id]) name String address String? city String? state String? country String @default("IN") timezone String @default("Asia/Kolkata") status RecordStatus @default(ACTIVE) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt gates Gate[] employees Employee[] visits Visit[] @@index([organizationId]) }
model Gate { id String @id @default(cuid()) organizationId String locationId String organization Organization @relation(fields:[organizationId], references:[id]) location Location @relation(fields:[locationId], references:[id]) name String code String type GateType @default(VISITOR) status RecordStatus @default(ACTIVE) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt visits Visit[] devices Device[] @@unique([organizationId, locationId, code]) }
model Device { id String @id @default(cuid()) organizationId String locationId String gateId String? gate Gate? @relation(fields:[gateId], references:[id]) name String type String @default("WEB_TABLET") status RecordStatus @default(ACTIVE) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([organizationId, locationId]) }
model Department { id String @id @default(cuid()) organizationId String organization Organization @relation(fields:[organizationId], references:[id]) name String code String? description String? status RecordStatus @default(ACTIVE) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt employees Employee[] visits Visit[] @@unique([organizationId, name]) }
model Employee { id String @id @default(cuid()) organizationId String locationId String? departmentId String? organization Organization @relation(fields:[organizationId], references:[id]) location Location? @relation(fields:[locationId], references:[id]) department Department? @relation(fields:[departmentId], references:[id]) employeeCode String? firstName String lastName String email String? phone String? designation String? profilePhotoUrl String? status RecordStatus @default(ACTIVE) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt users User[] hostedVisits Visit[] @@index([organizationId, email]) }
model Role { id String @id @default(cuid()) code String @unique name String permissions String[] users User[] }
model User { id String @id @default(cuid()) organizationId String? employeeId String? organization Organization? @relation(fields:[organizationId], references:[id]) employee Employee? @relation(fields:[employeeId], references:[id]) name String email String @unique phone String? passwordHash String roleId String role Role @relation(fields:[roleId], references:[id]) status RecordStatus @default(ACTIVE) lastLoginAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt visitsCreated Visit[] auditLogs AuditLog[] }
model Visitor { id String @id @default(cuid()) organizationId String organization Organization @relation(fields:[organizationId], references:[id]) firstName String lastName String phone String? email String? companyName String? photoUrl String? idType String? idLast4 String? idVerified Boolean @default(false) blacklisted Boolean @default(false) notes String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt visits Visit[] @@index([organizationId, phone]) }
model VisitorType { id String @id @default(cuid()) organizationId String organization Organization @relation(fields:[organizationId], references:[id]) name String description String? color String @default("gray") requiresApproval Boolean @default(true) requiresPhoto Boolean @default(false) requiresId Boolean @default(false) status RecordStatus @default(ACTIVE) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt visits Visit[] @@unique([organizationId, name]) }
model Visit { id String @id @default(cuid()) organizationId String visitorId String visitorTypeId String locationId String gateId String? hostEmployeeId String departmentId String? purpose String scheduledStart DateTime scheduledEnd DateTime? actualCheckin DateTime? actualCheckout DateTime? status VisitStatus @default(SCHEDULED) approvalStatus ApprovalStatus @default(PENDING) qrTokenHash String? qrExpiresAt DateTime? qrRevokedAt DateTime? qrUsedAt DateTime? passNumber String? photoAtCheckinUrl String? notes String? createdBy String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt organization Organization @relation(fields:[organizationId], references:[id]) visitor Visitor @relation(fields:[visitorId], references:[id]) visitorType VisitorType @relation(fields:[visitorTypeId], references:[id]) location Location @relation(fields:[locationId], references:[id]) gate Gate? @relation(fields:[gateId], references:[id]) hostEmployee Employee @relation(fields:[hostEmployeeId], references:[id]) department Department? @relation(fields:[departmentId], references:[id]) creator User? @relation(fields:[createdBy], references:[id]) @@index([organizationId, status, scheduledStart]) @@unique([organizationId, passNumber]) }
model AuditLog { id String @id @default(cuid()) organizationId String actorUserId String? action String entityType String entityId String oldValues Json? newValues Json? ipAddress String? userAgent String? createdAt DateTime @default(now()) organization Organization @relation(fields:[organizationId], references:[id]) actor User? @relation(fields:[actorUserId], references:[id]) @@index([organizationId, createdAt]) }
model CommunicationUsage { id String @id @default(cuid()) organizationId String month String channel NotificationChannel messagesSent Int @default(0) messagesFailed Int @default(0) organization Organization @relation(fields:[organizationId], references:[id]) @@unique([organizationId, month, channel]) }
model FileAsset { id String @id @default(cuid()) organizationId String storageKey String mimeType String size Int uploadedBy String? createdAt DateTime @default(now()) @@index([organizationId]) }
